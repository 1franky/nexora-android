# Copia este archivo a `keystore.properties` (gitignored, nunca se sube) para
# poder compilar `assembleRelease`/`bundleRelease` localmente con un keystore
# real. En CI no hace falta este archivo: el workflow de release
# (.github/workflows/release.yml) usa las variables de entorno equivalentes
# (KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD) a partir de
# GitHub Secrets.
storeFile=/ruta/absoluta/a/tu/release.keystore
storePassword=
keyAlias=nexora-release
keyPassword=
